{
    "name": "tadasei/laravel-keycloak-guard",
    "description": "My fork of leandrose/laravel-keycloak-guard.",
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/Tadasei/laravel-keycloak-guard",
    "keywords": [
        "laravel",
        "keycloak",
        "oauth2",
        "openid-connect",
        "authentication",
        "guard",
        "resource-server",
        "bearer-token"
    ],
    "authors": [
        {
            "name": "Tadasei",
            "email": "chemselhak.mahouche@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/auth": "^10|^11|^12|^13",
        "illuminate/cache": "^10|^11|^12|^13",
        "illuminate/contracts": "^10|^11|^12|^13",
        "illuminate/http": "^10|^11|^12|^13",
        "illuminate/support": "^10|^11|^12|^13",
        "guzzlehttp/guzzle": "^6.5|^7",
        "firebase/php-jwt": "^6.3|^7"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "orchestra/testbench": "^8|^9|^10",
        "phpunit/phpunit": "^9.5|^10|^11"
    },
    "autoload": {
        "psr-4": {
            "LeandroSe\\KeycloakGuard\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LeandroSe\\KeycloakGuard\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "XDEBUG_MODE=coverage php ./vendor/bin/phpunit --coverage-html=./coverage --configuration phpunit.xml"
    },
    "extra": {
        "laravel": {
            "providers": [
                "LeandroSe\\KeycloakGuard\\KeycloakAuthServiceProvider"
            ]
        }
    }
}
